# Formulaire de contact (optionnel) — envoi via Resend (https://resend.com)
# Sans ces variables, le formulaire propose automatiquement l'envoi par e-mail ou l'appel.
RESEND_API_KEY=
# Adresse qui reçoit les demandes
CONTACT_TO=belladelecouture@gmail.com
# Expéditeur vérifié dans Resend (ex. "Site Belladele <contact@votre-domaine.fr>")
CONTACT_FROM=
