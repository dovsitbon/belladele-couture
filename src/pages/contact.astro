---
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';
import Hours from '../components/Hours.astro';
import Icon from '../components/Icon.astro';
import MapFacade from '../components/MapFacade.astro';
import OpenStatus from '../components/OpenStatus.astro';
import { site } from '../data/site';
---
<Base
  title="Contact et rendez-vous à Groslay"
  description="Contactez l’atelier Belladele Couture, 1 rue Magnier Bédu à Groslay : 06 34 42 51 68, belladelecouture@gmail.com. Lundi au jeudi, 10 h 30 – 16 h. Demande de devis en ligne."
  breadcrumbs={[{ name: 'Contact', href: '/contact' }]}
>
  <section class="page-head">
    <div class="wrap">
      <p class="eyebrow">Contact</p>
      <h1>Prendre <em>rendez-vous</em></h1>
      <p class="lead">Le plus rapide est d’appeler l’atelier pendant les heures d’ouverture. Vous pouvez aussi laisser un message : la couturière vous rappelle.</p>
    </div>
  </section>

  <section class="section" style="padding-top:0" aria-label="Coordonnées et formulaire">
    <div class="wrap contact-grid">
      <aside class="card stack">
        <OpenStatus />
        <a class="btn call" href={site.phoneHref}><Icon name="phone" />{site.phone}</a>
        <ul class="contact-list">
          <li><Icon name="mail" /><a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li><Icon name="pin" /><a href={site.directionsUrl} rel="noopener" target="_blank">{site.address.street}, {site.address.postalCode} {site.address.city}</a></li>
          <li><Icon name="instagram" /><a href={site.social.instagram.url} rel="noopener" target="_blank">{site.social.instagram.handle}</a></li>
        </ul>
        <div>
          <h2 class="card__title">Horaires</h2>
          <Hours />
        </div>
      </aside>

      <div class="card">
        <h2 class="form-title">Demande de devis ou de rendez-vous</h2>
        <ContactForm />
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="acces-title">
    <div class="wrap">
      <h2 id="acces-title" style="margin-bottom:2rem">Accès</h2>
      <MapFacade />
    </div>
  </section>
</Base>

<style>
  .contact-grid { display: grid; gap: 1.5rem; align-items: start; }
  @media (min-width: 960px) { .contact-grid { grid-template-columns: 0.75fr 1.25fr; gap: 2rem; } }
  .card { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: clamp(1.5rem, 4vw, 2.5rem); }
  .call { width: 100%; font-size: 1.05rem; }
  .contact-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.25rem; }
  .contact-list li { display: flex; gap: 0.75rem; align-items: center; min-height: 2.75rem; overflow-wrap: anywhere; }
  .contact-list :global(svg) { width: 1.2rem; height: 1.2rem; color: var(--gold); flex: none; }
  .card__title { font-family: var(--sans); font-size: 0.75rem; letter-spacing: 0.16em; text-transform: uppercase; font-weight: 500; color: var(--gold); margin: 0.5rem 0 0.5rem; }
  .form-title { font-size: 1.9rem; margin-bottom: 1.5rem; }
</style>
