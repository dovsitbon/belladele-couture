---
import { fullAddress, nav, site } from '../data/site';
import Hours from './Hours.astro';
import Icon from './Icon.astro';
import Logo from './Logo.astro';
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="wrap footer__grid">
    <div class="footer__brand">
      <Logo tone="light" />
      <p>Création sur mesure de robes de soirée, de cocktail et de mariée, et retouches de vêtements à {site.address.city}.</p>
      <a class="footer__social" href={site.social.instagram.url} rel="noopener" target="_blank">
        <Icon name="instagram" /> {site.social.instagram.handle}
      </a>
    </div>

    <div>
      <h2 class="footer__title">L’atelier</h2>
      <address>
        <a href={site.directionsUrl} rel="noopener" target="_blank">{site.address.street}<br />{site.address.postalCode} {site.address.city}</a>
      </address>
      <p><a href={site.phoneHref}>{site.phone}</a></p>
      <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
    </div>

    <div>
      <h2 class="footer__title">Horaires</h2>
      <Hours tone="light" />
    </div>

    <div>
      <h2 class="footer__title">Pages</h2>
      <ul class="footer__links">
        <li><a href="/">Accueil</a></li>
        {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
      </ul>
    </div>
  </div>

  <div class="wrap footer__legal">
    <p>© {year} {site.legalTradeName} · {fullAddress}</p>
    <p><a href="/mentions-legales">Mentions légales</a> · <a href="/confidentialite">Confidentialité</a></p>
  </div>
</footer>

<style>
  .footer { background: var(--deep); color: var(--deep-ink-2); padding-top: clamp(3.5rem, 8vw, 5.5rem); font-size: 0.95rem; }
  .footer a { color: var(--deep-ink); text-decoration-color: rgba(243, 237, 227, 0.35); }
  .footer a:hover { color: #e2c48a; }
  .footer__grid { display: grid; gap: 2.5rem; }
  @media (min-width: 720px) { .footer__grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1040px) { .footer__grid { grid-template-columns: 1.4fr 1fr 1.1fr 0.8fr; gap: 3rem; } }
  .footer__brand p { margin-top: 1.1rem; max-width: 22rem; }
  .footer__social { display: inline-flex; align-items: center; gap: 0.5rem; margin-top: 1.2rem; min-height: 2.75rem; }
  .footer__social :global(svg) { width: 1.2rem; height: 1.2rem; }
  .footer__title { font-family: var(--sans); font-size: 0.75rem; letter-spacing: 0.16em; text-transform: uppercase; font-weight: 500; color: #d9b877; margin-bottom: 1rem; }
  address { font-style: normal; margin-bottom: 0.75rem; }
  .footer p + p { margin-top: 0.35rem; }
  .footer__links { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.15rem; }
  .footer__links a { display: inline-block; padding-block: 0.3rem; text-decoration: none; }
  .footer__legal {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.75rem;
    margin-top: 3.5rem; padding-block: 1.5rem; border-top: 1px solid rgba(243, 237, 227, 0.14); font-size: 0.85rem;
  }
</style>
