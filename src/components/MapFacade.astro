---
/** Carte Google chargée uniquement au clic (aucun cookie tiers avant consentement, page plus légère). */
import { fullAddress, site } from '../data/site';
import Icon from './Icon.astro';
---
<div class="map" data-map data-src={site.mapEmbedUrl}>
  <div class="map__placeholder">
    <Icon name="pin" class="map__pin" />
    <p class="map__addr">{fullAddress}</p>
    <p class="muted small">{site.address.city}, {site.address.region}</p>
    <div class="actions">
      <button type="button" class="btn btn--ghost" data-map-load>Afficher la carte</button>
      <a class="btn" href={site.directionsUrl} rel="noopener" target="_blank"><Icon name="directions" />Itinéraire</a>
    </div>
    <p class="muted small map__note">L’affichage de la carte charge un contenu Google Maps.</p>
  </div>
</div>

<style>
  .map { position: relative; aspect-ratio: 4 / 3; border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; background: var(--surface); }
  @media (min-width: 860px) { .map { aspect-ratio: auto; min-height: 26rem; height: 100%; } }
  .map__placeholder {
    position: absolute; inset: 0; display: grid; place-content: center; justify-items: center; text-align: center; gap: 0.6rem; padding: 1.5rem;
    background-image: radial-gradient(var(--line) 1px, transparent 1px); background-size: 18px 18px;
  }
  :global(.map__pin) { width: 2rem; height: 2rem; color: var(--gold); }
  .map__addr { font-family: var(--serif); font-size: 1.5rem; font-weight: 600; }
  .map .actions { justify-content: center; margin-top: 0.5rem; }
  .map__note { font-size: 0.78rem; }
  .map :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-map]').forEach((map) => {
    map.querySelector('[data-map-load]')?.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = map.dataset.src!;
      iframe.title = 'Plan d’accès à l’atelier Belladele Couture, Groslay';
      iframe.loading = 'lazy';
      iframe.referrerPolicy = 'no-referrer-when-downgrade';
      map.replaceChildren(iframe);
      iframe.focus();
    });
  });
</script>
